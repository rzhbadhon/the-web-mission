# ────────────────────────────────────────────────────────────────────────────
# The Web Mission — environment variables.
# Copy this file to ".env" (or ".env.local") and fill in your own values.
# The mission works out-of-the-box with zero env vars set (offline mode).
# ────────────────────────────────────────────────────────────────────────────

# ── The AI guide ─────────────────────────────────────────────────────────────
# Optional. If unset, the guide replies with offline comfort messages and the
# journey never advances past the voice stage (by design — you can tell at a
# glance whether the AI is live).
# Uses any OpenAI-compatible chat-completions endpoint.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ── The admin passkey ───────────────────────────────────────────────────────
# Visit /?admin=<ADMIN_KEY> to see the mission log (who tried, who said YES).
# Default: spidey. Pick something only you know.
ADMIN_KEY=spidey

# ── Public base URL (optional) ──────────────────────────────────────────────
# Set this to the URL you'll share with the guest. Currently informational
# (used by metadata only); the app is fully client-routed.
# NEXT_PUBLIC_SITE_URL=https://your-tunnel.example.com
